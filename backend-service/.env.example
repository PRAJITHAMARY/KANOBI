# Copy to .env and fill in. serverless.yml loads it (useDotenv) and passes these
# to every Lambda. STAGE_NAME is not read from here: serverless sets it from --stage.

# "dev" switches to local DynamoDB/S3 endpoints, runs event handlers in-process
# (LocalEventHub) and downloads deployments to ./.downloads. Any other value
# uses real AWS, async Lambda invocation for events, and /tmp.
NODE_ENV=dev

# Single DynamoDB table holding projects, models and deployments.
# serverless.yml creates it as "KanobiTable".
SERVICE_TABLE=KanobiTable

# Local endpoints, used only when NODE_ENV=dev (e.g. DynamoDB Local, LocalStack).
DYNAMODB_ENDPOINT=http://localhost:8000
S3_ENDPOINT=http://localhost:4566

# "localstack" deploys generated services to LocalStack with the local build runner
# (src/utils/localBuildRunner.ts) instead of CodeBuild, points CloudFormation/API
# Gateway at AWS_ENDPOINT and reports zero cost. Leave unset for real AWS.
# docker-compose.yml sets this for you.
# DEPLOY_TARGET=localstack
# AWS_ENDPOINT=http://localhost:4566

# Region for every AWS client (S3, DynamoDB, CodeBuild, CloudFormation, Cost Explorer, Lambda)
# and for the generated services' stacks.
AWS_DEPLOY_REGION=eu-west-1

# Static credentials used by the AWS clients and passed into CodeBuild.
# Never commit real values (see TODO.md: these should be replaced by IAM roles).
AWS_KEY=your-access-key-id
AWS_SECRET=your-secret-access-key

# Existing S3 bucket holding the boilerplate/ template, each project's generated
# source (<projectId>/), deployment zips and swagger files. Not created by serverless.yml.
BUCKET_NAME=your-kanobi-bucket
